# ============================================================
# Aegis One - AI Cyber Security War Room Backend Configuration
# ============================================================

# Database Configuration (PostgreSQL 16 with pgvector)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/warroom

# Application Configuration
APP_NAME="AI Cyber Security War Room API"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Configuration (Allowed frontend origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://aegis-warroom.vercel.app"]

# Machine Learning Paths & Telemetry Windows
MODELS_DIR=models
CORRELATION_WINDOW_MINUTES=30

# RAG & pgvector Semantic Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ============================================================
# Polymorphic LLM Inference Provider Configuration
# Choose between: "ollama" (local offline), "openai" (cloud), or "groq" (fast cloud)
# ============================================================
LLM_PROVIDER=ollama

# Provider 1: Local Ollama (Default & Offline)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3
OLLAMA_TIMEOUT=120.0

# Provider 2: Hosted OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Provider 3: Hosted Groq (Optional)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
